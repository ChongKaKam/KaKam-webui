# Generate each secret independently: openssl rand -hex 32
POSTGRES_PASSWORD=
MEMORY_DB_PASSWORD=
WEBUI_SECRET_KEY=
MEMORY_SERVICE_KEY=
# Permanent encryption key for admin configuration (openssl rand -hex 32).
# Back up separately from the database; losing it makes stored provider credentials unreadable.
MEMORY_CONFIG_ENCRYPTION_KEY=

# OpenAI-compatible endpoint including /v1; choose the actual model and dimension.
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSION=1536
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_TIMEOUT_SECONDS=25

# Optional independent summarization model. Required for automatic context compression.
# The WebUI chat model/API configuration is NOT automatically forwarded to this service.
MEMORY_CONTEXT_BASE_URL=
MEMORY_CONTEXT_API_KEY=
MEMORY_CONTEXT_MODEL=
MEMORY_CONTEXT_PROTOCOL=chat_completions
MEMORY_CONTEXT_ENABLED=true
MEMORY_CONTEXT_TIMEOUT_SECONDS=20

# Keep default when upgrading existing single-tenant memory data.
KAKAM_MEMORY_TENANT=default
# Set an HTTPS URL here only when using a separately deployed Memory server.
KAKAM_MEMORY_SERVICE_URL=http://memory-api:8081

KAKAM_MEMORY_RECALL_MODE=on
KAKAM_MEMORY_WRITE_MODE=on
KAKAM_MEMORY_TIMEOUT_MS=1500
OPEN_WEBUI_PORT=3000
